{
  "name": "get-it-in-writing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:full": "CONVEX_AGENT_MODE=anonymous bun node_modules/convex/dist/cli.bundle.cjs dev --start 'next dev --webpack'",
    "predev:full": "bun setup.mjs --once",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "build": "bun run typecheck && next build --webpack",
    "lint": "bun run typecheck && eslint app src convex tests next.config.ts playwright.config.ts vitest.config.ts --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "bun run build && PLAYWRIGHT_BROWSERS_PATH=.playwright playwright test",
    "preview": "serve out --single --listen 4173",
    "deploy": "bunx convex deploy --yes && bunx @convex-dev/static-hosting deploy --dist out --skip-convex"
  },
  "dependencies": {
    "@agentmail/convex": "0.1.0",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/static-hosting": "^0.2.1",
    "@firecrawl/firecrawl-convex": "0.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "lucide-react": "^1.37.0",
    "motion": "13.1.1",
    "next": "16",
    "openai": "^7.8.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vgpu": "0.3.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@webgpu/types": "^0.1.72",
    "convex-test": "^0.0.56",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.11"
  },
  "patchedDependencies": {
    "@agentmail/convex@0.1.0": "patches/@agentmail%2Fconvex@0.1.0.patch"
  }
}
